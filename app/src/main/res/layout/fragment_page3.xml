<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#F2F2F7"
    android:padding="12dp">
    <!-- Status bar comme screen 21:09 -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp">
        <TextView android:text="21:09" android:textStyle="bold" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#000"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
        <TextView android:text="📶 📶 📶 84%" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:text="V7-QUANTUM FAST" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:letterSpacing="0.1" android:textColor="#000" android:layout_marginBottom="16dp"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/widgetContainer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

    <!-- Dots comme sur screen -->
    <LinearLayout android:orientation="horizontal" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp">
        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#CCCCCC" android:layout_margin="4dp"/>
        <View android:layout_width="6dp" android:layout_height="6dp" android:background="#CCCCCC" android:layout_margin="4dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#000000" android:layout_margin="4dp"/>
    </LinearLayout>
</LinearLayout>
