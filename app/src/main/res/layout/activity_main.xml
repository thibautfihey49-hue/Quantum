<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
    <!-- Contenu scrollable en dessous de la clock -->
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="140dp" android:layout_marginTop="88dp">
        <LinearLayout android:id="@+id/widgetContainer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:paddingTop="16dp"/>
    </ScrollView>

    <!-- Top glass clock fixe -->
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:layout_gravity="top" app:cardCornerRadius="28dp" app:cardBackgroundColor="#22FFFFFF" app:cardElevation="12dp" app:strokeColor="#44FFFFFF" app:strokeWidth="1dp">
        <LinearLayout android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                <TextView android:id="@+id/txtClock" android:text="19:49" android:textSize="36sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtDate" android:text="Aujourd'hui" android:textColor="#CCFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/btnAddWidget" android:text="+" android:textSize="28sp" android:textColor="#FFFFFF" android:background="@drawable/app_bg" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Dock glass 3D fixe en bas -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="12dp">
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="32dp" app:cardBackgroundColor="#18FFFFFF" app:cardElevation="20dp" app:strokeColor="#33FFFFFF" app:strokeWidth="1dp">
            <LinearLayout android:id="@+id/dock" android:orientation="horizontal" android:gravity="center" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/dockPhone" android:text="📞" android:textSize="24sp" android:background="@drawable/app_bg" android:padding="14dp" android:layout_margin="6dp" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"/>
                <TextView android:id="@+id/dockMsg" android:text="💬" android:textSize="24sp" android:background="@drawable/app_bg" android:padding="14dp" android:layout_margin="6dp" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"/>
                <TextView android:id="@+id/dockDrawer" android:text="⬢" android:textSize="26sp" android:textColor="#FFFFFF" android:background="@drawable/glass_bg" android:padding="14dp" android:layout_margin="6dp" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center"/>
                <TextView android:id="@+id/dockCam" android:text="📷" android:textSize="24sp" android:background="@drawable/app_bg" android:padding="14dp" android:layout_margin="6dp" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"/>
                <TextView android:id="@+id/dockChrome" android:text="🌐" android:textSize="24sp" android:background="@drawable/app_bg" android:padding="14dp" android:layout_margin="6dp" android:layout_width="56dp" android:layout_height="56dp" android:gravity="center"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>
