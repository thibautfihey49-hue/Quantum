<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
    <ImageView android:id="@+id/wallpaperView" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="48dp" android:paddingBottom="120dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:overScrollMode="never" android:background="@android:color/transparent">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <FrameLayout android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/glass_color" android:padding="18dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/clock" android:text="22:52" android:textColor="#FFF" android:textSize="40sp" android:fontFamily="sans-serif-light" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/date" android:text="MAR. 18 AOÛT • Paris" android:textColor="#CCFFFFFF" android:textSize="11sp" android:layout_gravity="bottom|start" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/btnMenu" android:text="⋮" android:textSize="20sp" android:textColor="#FFF" android:background="@drawable/item_bg" android:padding="6dp" android:layout_gravity="top|end" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center"/>
            </FrameLayout>
            <!-- SEULEMENT METEO MAINTENANT, CLOCK SUPPRIMÉ -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="110dp" android:background="@drawable/glass_weather" android:padding="14dp">
                <TextView android:text="⛅" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="18°&#10;Partly Cloudy" android:textColor="#FFF" android:textSize="12sp" android:layout_gravity="bottom|start" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout android:id="@+id/addWidgetHint" android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/glass" android:layout_marginTop="16dp">
                <TextView android:text="+ Ajouter un widget (tape ici)" android:textColor="#88FFFFFF" android:textSize="13sp" android:layout_gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/widgetContainer" android:orientation="vertical" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingBottom="10dp"><LinearLayout android:id="@+id/dock" android:orientation="horizontal" android:gravity="center" android:background="@drawable/glass" android:padding="6dp" android:layout_width="match_parent" android:layout_height="68dp"><ImageView android:id="@+id/dPhone" android:padding="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="48dp"/><ImageView android:id="@+id/dMsg" android:padding="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="48dp"/><ImageView android:id="@+id/dExtra" android:padding="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="48dp"/><FrameLayout android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp" android:background="@drawable/glass_color"><ImageView android:id="@+id/dDrawer" android:src="@android:drawable/ic_menu_sort_by_size" android:tint="#FFF" android:layout_gravity="center" android:layout_width="22dp" android:layout_height="22dp"/></FrameLayout><ImageView android:id="@+id/dCam" android:padding="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="48dp"/><ImageView android:id="@+id/dChrome" android:padding="8dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="48dp"/></LinearLayout></FrameLayout>
</FrameLayout>
