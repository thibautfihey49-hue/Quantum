<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:layout_marginTop="86dp" android:paddingBottom="130dp" android:overScrollMode="never">
        <LinearLayout android:id="@+id/widgetContainer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp"/>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="@drawable/glass_bg" android:elevation="16dp" android:padding="16dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                <TextView android:id="@+id/txtClock" android:text="19:49" android:textSize="34sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtDate" android:textColor="#CCFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/btnAddWidget" android:text="+" android:textSize="28sp" android:textColor="#FFF" android:background="@drawable/app_bg" android:padding="10dp" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:padding="10dp">
        <LinearLayout android:id="@+id/dock" android:orientation="horizontal" android:gravity="center" android:padding="10dp" android:background="@drawable/glass_dock" android:elevation="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/dockPhone" android:text="📞" android:background="@drawable/app_bg" android:padding="12dp" android:layout_margin="5dp" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center"/>
            <TextView android:id="@+id/dockMsg" android:text="💬" android:background="@drawable/app_bg" android:padding="12dp" android:layout_margin="5dp" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center"/>
            <TextView android:id="@+id/dockDrawer" android:text="⬢" android:textSize="22sp" android:textColor="#FFF" android:background="@drawable/glass_bg" android:padding="12dp" android:layout_margin="5dp" android:layout_width="60dp" android:layout_height="60dp" android:gravity="center" android:elevation="10dp"/>
            <TextView android:id="@+id/dockCam" android:text="📷" android:background="@drawable/app_bg" android:padding="12dp" android:layout_margin="5dp" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center"/>
            <TextView android:id="@+id/dockChrome" android:text="🌐" android:background="@drawable/app_bg" android:padding="12dp" android:layout_margin="5dp" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
