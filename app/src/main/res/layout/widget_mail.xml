<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="18dp" app:cardElevation="2dp" android:layout_marginBottom="14dp">
 <LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="✉️" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <TextView android:text="Gmail" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
   <TextView android:id="@+id/txtMailCount" android:text="Ouvrir" android:background="#C8E6C9" android:padding="6dp" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <TextView android:id="@+id/txtMail1" android:text="• Boîte de réception Gmail" android:textSize="12sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/txtMail2" android:text="Clique pour voir tes vrais mails non lus" android:textSize="11sp" android:textColor="#666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
</androidx.cardview.widget.CardView>
