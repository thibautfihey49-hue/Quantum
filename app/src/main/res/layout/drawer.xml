<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E6000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="60dp" android:orientation="vertical" android:background="#FF121212" android:padding="12dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/search" android:hint="Rechercher" android:textColor="#FFF" android:textColorHint="#44FFFFFF" android:background="@drawable/glass" android:padding="12dp" android:textSize="14sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="44dp"/>
            <TextView android:id="@+id/close" android:text="✕" android:textColor="#FFF" android:padding="12dp" android:background="@drawable/item_bg" android:layout_marginStart="8dp" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never"/>
    </LinearLayout>
</FrameLayout>
