<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="340dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/dialog_glass" android:padding="18dp">
    <TextView android:text="⚡ Booster Quantum" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Nettoyage réel système • sans root" android:textColor="#88FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="12dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="RAM" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <ProgressBar android:id="@+id/ramBar" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="65" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="8dp"/>
        <TextView android:id="@+id/ramText" android:text="Utilisée: -- / --" android:textColor="#FFF" android:textSize="11sp" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/ramFree" android:text="Dispo: --" android:textColor="#99FFFFFF" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="10dp" android:layout_weight="1" android:layout_marginRight="5dp" android:layout_width="0dp" android:layout_height="wrap_content">
            <TextView android:text="Cache" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/cacheText" android:text="-- MB" android:textColor="#FFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="10dp" android:layout_weight="1" android:layout_marginLeft="5dp" android:layout_width="0dp" android:layout_height="wrap_content">
            <TextView android:text="Fichiers inutiles" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/junkText" android:text="-- MB" android:textColor="#FFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/junkList" android:text="Scan..." android:textColor="#88FFFFFF" android:textSize="10sp" android:maxLines="4" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/bCleanRam" android:text="Nettoyer RAM" android:textColor="#FFF" android:background="@drawable/btn_glass" android:gravity="center" android:padding="12dp" android:textSize="11sp" android:layout_weight="1" android:layout_marginRight="4dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/bCleanCache" android:text="Vider Cache" android:textColor="#FFF" android:background="@drawable/btn_glass" android:gravity="center" android:padding="12dp" android:textSize="11sp" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_marginRight="4dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/bCleanJunk" android:text="Fichiers" android:textColor="#FFF" android:background="@drawable/btn_glass" android:gravity="center" android:padding="12dp" android:textSize="11sp" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/bBoostAll" android:text="⚡ BOOSTER TOUT NETTOYER" android:textColor="#000" android:background="@drawable/edit_white" android:gravity="center" android:textStyle="bold" android:padding="14dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bCloseBooster" android:text="Fermer" android:textColor="#88FFFFFF" android:gravity="center" android:padding="8dp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
