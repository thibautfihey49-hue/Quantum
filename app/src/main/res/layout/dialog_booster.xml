<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="340dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/dialog_glass" android:padding="18dp">
    <TextView android:text="⚡ Vrai Nettoyeur" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Méthode CacheFlow • Sans root • 100% réel" android:textColor="#88FFFFFF" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/boosterStatus" android:text="Vérification permissions..." android:textColor="#FFFFAA" android:textSize="11sp" android:background="@drawable/search_glass" android:padding="10dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="12dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="RAM (info seulement - Android gère tout seul)" android:textColor="#88FFFFFF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/ramText" android:text="--" android:textColor="#FFF" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="10dp" android:layout_weight="1" android:layout_marginRight="5dp" android:layout_width="0dp" android:layout_height="wrap_content">
            <TextView android:text="Cache total réel" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/cacheText" android:text="-- MB" android:textColor="#FFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/cacheCount" android:text="-- apps" android:textColor="#88FFFFFF" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/search_glass" android:padding="10dp" android:layout_weight="1" android:layout_marginLeft="5dp" android:layout_width="0dp" android:layout_height="wrap_content">
            <TextView android:text="Fichiers inutiles" android:textColor="#FFF" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/junkText" android:text="-- MB" android:textColor="#FFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/junkList" android:text="Scan..." android:textColor="#88FFFFFF" android:textSize="10sp" android:maxLines="6" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bGrantUsage" android:text="1. Autoriser accès utilisation" android:textColor="#000" android:background="@drawable/edit_white" android:gravity="center" android:padding="12dp" android:textSize="12sp" android:visibility="gone" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bGrantAccess" android:text="2. Activer service accessibilité" android:textColor="#000" android:background="@drawable/edit_white" android:gravity="center" android:padding="12dp" android:textSize="12sp" android:visibility="gone" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bBoostAll" android:text="⚡ VRAI NETTOYAGE AUTO" android:textColor="#000" android:background="@drawable/edit_white" android:gravity="center" android:textStyle="bold" android:padding="14dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Ouvre chaque app dans Paramètres et clique 'Vider cache' tout seul. Seule méthode non-root qui marche." android:textColor="#66FFFFFF" android:textSize="9sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/bCloseBooster" android:text="Fermer" android:textColor="#88FFFFFF" android:gravity="center" android:padding="8dp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
